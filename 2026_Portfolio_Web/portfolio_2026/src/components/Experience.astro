---
import "../styles/experience.css";
---

<div class="experience" id="experience">
    <div class="experience-container">
        <h1>Experience</h1>
    </div>
    <div class="experience-card-group">
        <div class="experience-card">
            <div class="company-desc">
                <h2>WorkCover Queensland</h2>
                <h3>Feb 2022 - Present</h3>
            </div>
            <div class="title-desc">
                <h3>Software Engineer</h3>
            </div>
            <p>Working with Java, SpringBoot, RDBMS(Oracle) building web applications. Managing fullstack web applications.</p>
        </div>
        <div class="experience-card">
            <div class="company-desc">
                <h2>Infosys</h2>
                <h3>Jun 2021 - Feb 2022</h3>
            </div>
            <div class="title-desc">
                <h3>Graduate Associate</h3>
            </div>
            <p>Graduate developer primarily working with JavaScript and React.js. Experience in creating automated chatbots using LivePerson. LivePerson certified developer.</p>
        </div>
    </div>
</div>